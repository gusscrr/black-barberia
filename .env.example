PORT=3000
DB_FILE=./data/black-barberia.db
# Clave del panel de administración: 12 caracteres o más. Si no la cambiás, el panel queda apagado.
ADMIN_KEY=cambia-esta-clave
# Zona horaria de la barbería (para que los horarios anden bien aunque el servidor esté en otro país)
TIMEZONE=America/Argentina/Buenos_Aires

# WhatsApp Cloud API (opcional para empezar)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
# Si usas una plantilla aprobada, pon su nombre aquí. Si queda vacío, intenta enviar texto.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR